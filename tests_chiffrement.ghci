--afficher_key dechiffrement_state_B
--afficher_key input_C
--afficher_key dechiffrement_key_C1

--tests plus petits étapes par étape:
b_in= output_key_C1
test_1= afficher_key (state_vers_octets (addRoundKey (octets_vers_state b_in) (intervale_4 nr w_annexe_C))) -- intialisation validee
