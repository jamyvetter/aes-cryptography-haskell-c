----------- Synthèse Visuelle des Tests -----------

-- on exécute la fonction suivante dans GHCI pour avoir un résultat immédiat
:{
runTests :: IO ()
runTests = do
    putStrLn "--- Validation du Chiffrement Complet ---"
    putStrLn $ "Cipher AES-128 (Annexe B) : " ++ if test_cipher_B then "OK" else "ECHEC"
    putStrLn $ "Cipher AES-128 (Annexe C) : " ++ if test_cipher_C then "OK" else "ECHEC"
    
    putStrLn "\n--- Validation des transformations Inverses ---"
    putStrLn $ "InvShiftRows   : " ++ if test_inv_shift then "OK" else "ECHEC"
    putStrLn $ "InvSubBytes    : " ++ if test_inv_sub then "OK" else "ECHEC"
    putStrLn $ "InvMixColumns  : " ++ if test_inv_mix then "OK" else "ECHEC"
    putStrLn $ "InvAddRoundKey : " ++ if test_inv_addkey then "OK" else "ECHEC"
:}