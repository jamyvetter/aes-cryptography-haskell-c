:load AES

----------- Variables de validation (résultats attendus) --------

-- Z2
l0 = [Z2 0]
l1 = [Z2 1, Z2 1]
l2 = [Z2 0, Z2 1]

-- Polynomes
p0 = Polynome l0  -- Polynome nul
p1 = Polynome l1  -- 1 + X
p2 = Polynome l2  -- X
p3 = Polynome [Z2 0, Z2 0, Z2 1] -- X^2
p_complexe_1 = Polynome [Z2 1, Z2 0, Z2 0, Z2 1]
p_complexe_2 = Polynome [Z2 0, Z2 0, Z2 0, Z2 0, Z2 1, Z2 0, Z2 0, Z2 1]
m = Polynome [Z2 1, Z2 1, Z2 0, Z2 1, Z2 1, Z2 0, Z2 0, Z2 0, Z2 1]

-- GF28
q0 = GF28 (Polynome l0)  
q10 = GF28 (Polynome l1) 
q1 = GF28 (Polynome l2) 
q2 = GF28 (Polynome [Z2 0, Z2 0, Z2 1]) 
q7 = GF28 (Polynome [Z2 0, Z2 0, Z2 0, Z2 0, Z2 0, Z2 0, Z2 0, Z2 1]) 


----------- 1. Tests Z2 et listes -----------
-- Arithmétique de base sur Z2
test_addZ2 = add (Z2 1) (Z2 1) == Z2 0
test_mulZ2 = mul (Z2 1) (Z2 1) == Z2 1

-- Arithmétique de base sur les listes d'éléments Z2
test_addL = addL l1 l2 == [Z2 1, Z2 0]
test_mulL = mulL l1 l2 == [Z2 0, Z2 1, Z2 1]





----------- 2. Tests polynomes -----------
-- Addition
test_addp_1 = addp p0 p1 == Polynome [Z2 1, Z2 1]
test_addp_2 = addp p1 p2 == Polynome [Z2 1, Z2 0]

-- Multiplication
test_mulp_nul = mulp p1 p0 == Polynome [Z2 0]
test_mulp_p1p2 = mulp p1 p2 == Polynome [Z2 0, Z2 1, Z2 1]
test_mulp_complexe = mulp p_complexe_1 p_complexe_2 == Polynome [Z2 0, Z2 0, Z2 0, Z2 0, Z2 1, Z2 0, Z2 0, Z2 0, Z2 0, Z2 0, Z2 1]

-- Degré
test_degre_1 = degre p1 == 1
test_degre_2 = degre p2 == 1
test_degre_3 = degre p_complexe_1 == 3

-- Division euclidienne
test_depol_1 = de_pol (Polynome [Z2 0, Z2 0, Z2 0, Z2 0, Z2 1, Z2 0, Z2 0, Z2 0, Z2 0, Z2 0, Z2 1]) m == (Polynome [Z2 0, Z2 0, Z2 1], Polynome [Z2 0, Z2 0, Z2 1, Z2 1, Z2 1, Z2 1, Z2 1, Z2 0, Z2 0, Z2 0, Z2 0])
test_depol_2 = de_pol p2 m == (zero, p2)


----------- 3. Tests euclide etendu -----------
test_euclide_1 = euclide (p3, p2) == (Polynome [Z2 0, Z2 1], zero, un)
test_euclide_2 = euclide (p2, p3) == (Polynome [Z2 0, Z2 1], un, zero)


----------- 4. Tests GF28 -----------
-- Multiplication dans GF(2^8) (Exemple du diapo)
gf28_a = GF28 (Polynome [Z2 1, Z2 0, Z2 0, Z2 1])
gf28_b = GF28 (Polynome [Z2 0, Z2 0, Z2 0, Z2 0, Z2 1, Z2 0, Z2 0, Z2 1])
gf28_attendu = GF28 (Polynome [Z2 0, Z2 0, Z2 1, Z2 1, Z2 1, Z2 1, Z2 1, Z2 0, Z2 0, Z2 0, Z2 0])
test_mul_gf28 = mul gf28_a gf28_b == gf28_attendu


----------- Synthèse des tests -----------

:{
runTestsAnneaux :: IO ()
runTestsAnneaux = do
    putStrLn "\n--- Validation Z2 et listes ---"
    putStrLn $ "Addition sur Z2 : " ++ if test_addZ2 then "OK" else "ECHEC"
    putStrLn $ "Multiplication sur Z2 : " ++ if test_mulZ2 then "OK" else "ECHEC"
    putStrLn $ "Addition de listes (addL) : " ++ if test_addL then "OK" else "ECHEC"
    putStrLn $ "Multiplication de listes (mulL) : " ++ if test_mulL then "OK" else "ECHEC"


    putStrLn "\n--- Validation polynomes ---"
    putStrLn $ "Addition (addp) : " ++ if (test_addp_1 && test_addp_2) then "OK" else "ECHEC"
    putStrLn $ "Multiplication (mulp) : " ++ if (test_mulp_nul && test_mulp_p1p2 && test_mulp_complexe) then "OK" else "ECHEC"
    putStrLn $ "Calcul du degré : " ++ if (test_degre_1 && test_degre_2 && test_degre_3) then "OK" else "ECHEC"
    putStrLn $ "Division euclidienne : " ++ if (test_depol_1 && test_depol_2) then "OK" else "ECHEC"

    putStrLn "\n--- Validation euclide etendu ---"
    putStrLn $ "Algorithme d'Euclide : " ++ if (test_euclide_1 && test_euclide_2) then "OK" else "ECHEC"

    putStrLn "\n--- Validation GF(2^8) ---"
    putStrLn $ "Multiplication GF28 (Diapo): " ++ if test_mul_gf28 then "OK" else "ECHEC"
:}
